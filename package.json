{
  "name": "pi-fusion",
  "version": "0.2.0",
  "description": "Task-aware model routing and workflow control plane for Pi and 9Router (full-product v2, in development)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "9router",
    "shadow-routing",
    "active-routing"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-fusion.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1",
    "test:integration": "node --test --test-concurrency=1 test/router.integration.test.ts test/extension-harness.test.ts test/pi-host-loader.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/node": "24.12.0",
    "typescript": "5.9.3"
  }
}
